# Lakemeter local development environment variables.
# Copy this file to .env (next to docker-compose.yml) and adjust as needed.
# docker compose reads .env automatically for ${VAR} interpolation.

# --- AI chat: OpenAI-compatible backend (optional) ---
# Leave OPENAI_BASE_URL and OPENAI_API_KEY empty to keep the default
# Databricks FMAPI mode (DATABRICKS_HOST + CLAUDE_MODEL_ENDPOINT).
#
# Any OpenAI-compatible API works: OpenAI, Ollama, vLLM, LM Studio, ...
# OPENAI_BASE_URL must include the /v1 suffix.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Examples:
#
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#
# Ollama (local, keyless — leave the key empty):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=
#   OPENAI_MODEL=llama3.2

# Other backend settings (database URL, LOCAL_DEV_EMAIL, bootstrap flags)
# are managed directly in docker-compose.yml.
